# Required. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Price source. TinyFish (search + page fetch, free on all plans) is used when its key is set:
# https://tinyfish.ai. Serper (Google Shopping, 2,500 free queries) is the fallback: https://serper.dev
TINYFISH_API_KEY=
TINYFISH_SEARCH_RPM=30
PRICE_EXTRACT_MODEL=gemini-3.5-flash-lite
# Books not priced this many seconds after the sweep are left unpriced (review queue) to keep the 5-minute budget
PRICE_DEADLINE_S=210
SERPER_API_KEY=

# Optional: better catalogue data (physical dimensions) for identification and scale.
# Create at console.cloud.google.com > APIs & Services > enable "Books API" > Credentials > API key
GOOGLE_BOOKS_API_KEY=

# Models (defaults are current as of Oct 2026)
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.8-flash
LIVE_VOICE=Kore

# Locale the agent proposes; the user confirms or changes it by voice
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# Capture-quality thresholds (raw scores are logged per frame for recalibration)
BLUR_RATIO_THRESHOLD=0.10
MIN_TEXTURE=0.04
GLARE_THRESHOLD=0.03
DARK_THRESHOLD=45
NUDGE_COOLDOWN_S=6

# Frames analysed per sweep (one vision call each). Lower it on the free tier (~20 requests/day/model).
MAX_ANALYSED_FRAMES=90

# Room geometry: reconstructions from staggered frame subsets, cross-checked (about 10 s each on Apple M4)
ROOM_ENSEMBLE=5
DA3_MODEL=depth-anything/DA3-BASE
